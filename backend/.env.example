# Copy to backend/.env and fill in. Never commit the real .env.

# --- TypeSafe / Jev (System One) ---
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Model for the second "Jev Preview" player (jev-preview = newest release, official or not).
JEV_PREVIEW_MODEL=jev-preview
# Ask Jev for extra score/noul signals on every move (1 = on). They are logged, not used to pick the move.
JEV_SIGNALS=1

# --- OpenAI (GPT player) ---
OPENAI_API_KEY=sk-proj-...your-key...
OPENAI_MODEL=gpt-6-luna
# gpt-6-luna reasoning effort: none (answer directly) | low | medium | high | xhigh | max.
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_TOKENS=512

# --- Amazon Bedrock (all Claude calls go through Bedrock) ---
AWS_REGION=
AWS_PROFILE=
BEDROCK_MODEL_ID=
BEDROCK_OPUS_MODEL_ID=
# Put a cache point after the static system prompt (only pays off once the prefix
# is above the model's minimum cacheable length).
BEDROCK_PROMPT_CACHE=1
# Budget for the normal Opus/Sonnet players (thinking can't be switched off on these models,
# so they get room for a short reason before the final "MOVE: n" line).
CLAUDE_FAST_MAX_TOKENS=512
# Tiny budget used only by the "thinking, 16-token budget (bug repro)" player.
CLAUDE_MAX_TOKENS=16
# Budget used by the "thinking (fixed)" variant.
CLAUDE_THINKING_MAX_TOKENS=4096
# Thinking config sent with the thinking variants (Bedrock additionalModelRequestFields.thinking).
CLAUDE_THINKING_CONFIG={"type": "adaptive"}

# --- Prices in USD per 1M tokens. Leave blank to show "price unknown". ---
# Fill from the AWS Bedrock pricing page for your region.
# Claude: https://claude.com/pricing (Oct 2026; Bedrock on-demand lists the same input/output rates).
# Jev: https://typesafe.ai ($42 per billion input tokens; output is free).
PRICE_OPUS_IN=4
PRICE_OPUS_OUT=20
PRICE_OPUS_CACHE_READ=0.20
PRICE_OPUS_CACHE_WRITE=5
PRICE_SONNET_IN=2
PRICE_SONNET_OUT=10
PRICE_SONNET_CACHE_READ=0.20
PRICE_SONNET_CACHE_WRITE=2.50
# Smaller / earlier Claude models (claude.com/pricing, Oct 2026; Haiku 5.5 = prompts <= 100K tokens).
PRICE_SONNET5_IN=2
PRICE_SONNET5_OUT=10
PRICE_SONNET5_CACHE_READ=0.20
PRICE_SONNET5_CACHE_WRITE=2.50
PRICE_SONNET46_IN=3
PRICE_SONNET46_OUT=15
PRICE_SONNET46_CACHE_READ=0.30
PRICE_SONNET46_CACHE_WRITE=3.75
PRICE_SONNET45_IN=3
PRICE_SONNET45_OUT=15
PRICE_SONNET45_CACHE_READ=0.30
PRICE_SONNET45_CACHE_WRITE=3.75
PRICE_HAIKU55_IN=0.10
PRICE_HAIKU55_OUT=0.50
PRICE_HAIKU55_CACHE_READ=0.01
PRICE_HAIKU55_CACHE_WRITE=0.125
PRICE_HAIKU45_IN=1
PRICE_HAIKU45_OUT=5
PRICE_HAIKU45_CACHE_READ=0.10
PRICE_HAIKU45_CACHE_WRITE=1.25
PRICE_JEV_IN=0.042
PRICE_JEV_OUT=0
# OpenAI gpt-6-luna (developers.openai.com/api/docs/models/gpt-6-luna, Oct 2026). No cache-write charge.
PRICE_OPENAI_IN=0.10
PRICE_OPENAI_OUT=0.50
PRICE_OPENAI_CACHE_READ=0.01
PRICE_OPENAI_CACHE_WRITE=0

# --- Langfuse (optional; tracing is skipped when these are empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend origin for CORS (only needed if you call the API directly, not via the Next.js proxy) ---
CORS_ORIGINS=http://localhost:3000
